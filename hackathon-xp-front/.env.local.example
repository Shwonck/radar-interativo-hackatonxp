# Exemplo de configuração local do front-end. Copie para .env.local e preencha.
# Sem essas variáveis o app roda 100% com dados fictícios (isMock: true).

# URL base do backend .NET (Open Finance). Quando ausente, o front usa os mocks locais.
# Ex.: http://localhost:5000
NEXT_PUBLIC_API_URL=

# Credenciais server-only usadas pelo lib/api.ts para obter o JWT do backend
# (POST /api/auth/login). Nunca são expostas ao navegador. Preencha apenas em ambiente
# com backend real; para a demo offline deixe em branco.
BACKEND_API_EMAIL=
BACKEND_API_PASSWORD=
